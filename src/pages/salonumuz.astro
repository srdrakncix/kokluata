---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { SITE, whatsapp } from '../data/site';

const photos = [
  { src: 'salonumuz-1', alt: 'Salonun ortasındaki profesyonel ring, kırmızı-siyah mat', span: 'tall' },
  { src: 'salonumuz-3', alt: 'Kum torbası, ağırlık ve pad köşesi', span: '' },
  { src: 'salonumuz-7', alt: 'Functional training istasyonu: barfiks, bench, kettlebell', span: '' },
  { src: 'salonumuz-10', alt: 'KASK Team duvar çizimi', span: '' },
  { src: 'salonumuz-8', alt: '"You are stronger than you think" duvar yazısı', span: 'tall' },
  { src: 'salonumuz-6', alt: 'Salon girişi, Karate Kick Boks Personal Training tabelası', span: '' },
  { src: 'salonumuz-2', alt: 'Samuray duvar çizimi', span: '' },
  { src: 'salonumuz-9', alt: 'Mike Tyson duvar çizimi', span: '' },
];
const facts = [
  { n: '250', u: 'm²', l: 'Toplam alan' },
  { n: '1', u: '', l: 'Profesyonel ring' },
  { n: '2017', u: '', l: 'Açılış yılı' },
  { n: '∞', u: '', l: 'Ücretsiz otopark' },
];
---

<Base
  title="Salonumuz – Ringli 250 m² Kickboks Salonu"
  description="Bornova Yeşilova'da 250 m² kickboks salonu: profesyonel ring, kum torbaları, pad ve functional training alanı, ücretsiz otopark. Fotoğraflar ve adres."
  ogImage="/img/salonumuz-1.webp"
>
  <PageHero
    eyebrow="Salonumuz"
    title="250 m²,"
    titleAccent="bir ring."
    lead="90 m²'de başladık, bugün Bornova'nın ringli salonuyuz. Kum torbaları, pad köşesi, functional alanı ve duvarlarda seni gaza getirecek birkaç isim."
    img="/img/salonumuz-1.webp"
    imgAlt="Köklü Ata salonundaki profesyonel ring"
    crumbs={[{ href: '/salonumuz/', label: 'Salon' }]}
  >
    <Fragment slot="actions">
      <a href={SITE.maps} class="btn" target="_blank" rel="noopener">Yol tarifi al</a>
      <a href={whatsapp('Merhaba, salonu ziyaret etmek istiyorum.')} class="btn btn--ghost" target="_blank" rel="noopener">Ziyaret ayarla</a>
    </Fragment>
  </PageHero>

  <section class="facts">
    <div class="container facts__grid" data-reveal-stagger>
      {facts.map((f) => (
        <div class="fact">
          <span class="fact__n">{f.n}<small>{f.u}</small></span>
          <span class="fact__l">{f.l}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section gal">
    <div class="container">
      <div class="gal__head" data-reveal>
        <p class="eyebrow">Fotoğraflar</p>
        <h2 class="h-2">İçeri gir.</h2>
      </div>
      <div class="gal__grid" data-reveal-stagger>
        {photos.map((p) => (
          <figure class:list={['gal__item', p.span]}>
            <img src={`/img/${p.src}.webp`} alt={p.alt} loading="lazy" width="768" height="1024" />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section where">
    <div class="container where__in">
      <div class="where__text" data-reveal>
        <p class="eyebrow">Nerede?</p>
        <h2 class="h-2">Yeşilova,<br />Bornova.</h2>
        <address>
          {SITE.address.street}<br />{SITE.address.district} / {SITE.address.city}
        </address>
        <ul class="where__list">
          <li>Salon önünde ücretsiz otopark</li>
          <li>Bornova metro ve Yeşilova hattına yakın</li>
          <li>Bekleme alanı yok; veliler ders bitiminde alıyor</li>
        </ul>
        <a href={SITE.maps} class="btn" target="_blank" rel="noopener">Google Haritalar'da aç</a>
      </div>
      <div class="where__map" data-reveal>
        <iframe
          title="Köklü Ata Kickboks harita"
          src={`https://www.google.com/maps?q=${encodeURIComponent(SITE.address.street + ' ' + SITE.address.district + ' ' + SITE.address.city)}&output=embed`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>
</Base>

<style>
  .facts {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .facts__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .fact {
    display: grid;
    gap: 6px;
    padding: 32px 24px;
    border-right: 1px solid var(--line);
  }
  .fact:first-child {
    padding-left: 0;
  }
  .fact:last-child {
    border-right: 0;
  }
  .fact__n {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    line-height: 1;
  }
  .fact__n small {
    font-size: 0.5em;
    color: var(--red-2);
    margin-left: 4px;
  }
  .fact__l {
    color: var(--fg-3);
    font-size: 0.85rem;
  }
  .gal__head {
    display: grid;
    gap: 16px;
    margin-bottom: 48px;
  }
  .gal__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 260px;
    grid-auto-flow: dense;
    gap: 12px;
  }
  .gal__item {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
  }
  .gal__item.tall {
    grid-row: span 2;
  }
  .gal__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85);
    transition: transform 0.8s var(--ease-out), filter 0.5s;
  }
  .gal__item:hover img {
    transform: scale(1.05);
    filter: none;
  }
  .where {
    border-top: 1px solid var(--line);
    background: var(--bg-2);
  }
  .where__in {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  .where__text {
    display: grid;
    gap: 20px;
    justify-items: start;
    color: var(--fg-2);
  }
  .where__text h2 {
    color: var(--fg);
  }
  .where__text address {
    font-style: normal;
    font-size: 1.1rem;
    color: var(--fg);
  }
  .where__list {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: 6px;
  }
  .where__map {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .where__map iframe {
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(1) invert(0.9) contrast(1.1);
  }
  @media (max-width: 900px) {
    .facts__grid {
      grid-template-columns: 1fr 1fr;
    }
    .fact:nth-child(2n) {
      border-right: 0;
    }
    .fact:nth-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }
    .gal__grid {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 200px;
    }
    .where__in {
      grid-template-columns: 1fr;
    }
  }
</style>
