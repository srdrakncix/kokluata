---
import { PROGRAMS } from '../data/site';
interface Props {
  exclude?: string;
  heading?: boolean;
}
const { exclude, heading = true } = Astro.props;
const list = PROGRAMS.filter((p) => p.slug !== exclude);
---

<section class="section programs theme-light" id="dersler">
  <div class="container">
    {heading && (
      <div class="programs__head">
        <p class="eyebrow">Dersler</p>
        <h2 class="h-2 mask-lines">
          <span class="line"><span>Seviyene göre</span></span>
          <span class="line"><span>bir <span class="text-red">program</span> var.</span></span>
        </h2>
      </div>
    )}
    <div class="programs__grid" data-reveal-stagger>
      {list.map((p, i) => (
        <a href={`/${p.slug}/`} class="pcard" style={`--i:${i}`}>
          <div class="pcard__media">
            <img src={p.img} alt="" loading="lazy" width="1080" height="720" data-parallax="8" />
          </div>
          <div class="pcard__body">
            <span class="pcard__tag">{p.tag}</span>
            <h3 class="h-3">{p.title}</h3>
            <p>{p.short}</p>
            <span class="pcard__more">
              İncele
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .programs__head {
    display: grid;
    gap: 16px;
    margin-bottom: clamp(40px, 5vw, 64px);
  }
  .programs__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .pcard {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.4s, transform 0.5s var(--ease-out);
  }
  .pcard:hover {
    border-color: rgba(216, 16, 46, 0.6);
    transform: translateY(-4px);
  }
  .pcard__media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    position: relative;
  }
  .pcard__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, var(--bg-2) 100%);
    pointer-events: none;
  }
  .pcard__media img {
    width: 100%;
    height: 120%;
    object-fit: cover;
    filter: grayscale(0.35) contrast(1.05);
    transition: filter 0.6s, transform 0.8s var(--ease-out);
  }
  .pcard:hover .pcard__media img {
    filter: grayscale(0) contrast(1.05);
    transform: scale(1.05);
  }
  .pcard__body {
    padding: 24px;
    display: grid;
    gap: 12px;
    align-content: start;
    color: var(--fg-2);
  }
  .pcard__body h3 {
    color: var(--fg);
  }
  .pcard__tag {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--red-2);
  }
  .pcard__more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    color: var(--fg);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .pcard__more svg {
    width: 18px;
    height: 18px;
    transition: transform 0.4s var(--ease-out);
  }
  .pcard:hover .pcard__more svg {
    transform: translateX(6px);
  }
  @media (max-width: 960px) {
    .programs__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .programs__grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .pcard__media {
      aspect-ratio: 16 / 7;
    }
    .pcard__body {
      padding: 20px;
      gap: 8px;
    }
  }
</style>
