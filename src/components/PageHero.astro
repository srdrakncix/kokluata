---
interface Props {
  eyebrow: string;
  title: string;
  titleAccent?: string;
  lead: string;
  img?: string;
  imgAlt?: string;
  crumbs?: { href: string; label: string }[];
}
const { eyebrow, title, titleAccent, lead, img, imgAlt = '', crumbs = [] } = Astro.props;
---

<section class:list={['phero', { 'phero--img': !!img }]}>
  <div class="phero__glow" aria-hidden="true"></div>
  <div class="container phero__in">
    <div class="phero__text">
      {crumbs.length > 0 && (
        <nav class="crumbs" aria-label="Sayfa yolu">
          <a href="/">Ana sayfa</a>
          {crumbs.map((c) => (
            <>
              <span aria-hidden="true">/</span>
              <a href={c.href}>{c.label}</a>
            </>
          ))}
        </nav>
      )}
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="h-1 mask-lines">
        <span class="line"><span>{title}</span></span>
        {titleAccent && <span class="line"><span class="text-red">{titleAccent}</span></span>}
      </h1>
      <p class="lead" data-reveal>{lead}</p>
      <div class="phero__actions" data-reveal>
        <slot name="actions" />
      </div>
    </div>
    {img && (
      <div class="phero__media" data-reveal>
        <img src={img} alt={imgAlt} width="1080" height="720" fetchpriority="high" data-parallax="8" />
      </div>
    )}
  </div>
</section>

<style>
  .phero {
    position: relative;
    padding-block: 160px 72px;
    overflow: clip;
  }
  .phero__glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(ellipse 50% 60% at 80% 20%, rgba(216, 16, 46, 0.22), transparent 65%);
  }
  .phero__in {
    display: grid;
    gap: 48px;
    align-items: end;
  }
  .phero--img .phero__in {
    grid-template-columns: 1.1fr 1fr;
  }
  .phero__text {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .phero__text h1 {
    line-height: 0.9;
  }
  .phero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .phero__actions:empty {
    display: none;
  }
  .crumbs {
    display: flex;
    gap: 10px;
    font-size: 0.8rem;
    color: var(--fg-3);
  }
  .crumbs a:hover {
    color: var(--fg);
  }
  .phero__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
  }
  .phero__media img {
    width: 100%;
    height: 120%;
    object-fit: cover;
    filter: contrast(1.05) saturate(0.85);
  }
  @media (max-width: 900px) {
    .phero {
      padding-top: 120px;
    }
    .phero--img .phero__in {
      grid-template-columns: 1fr;
    }
  }
</style>
