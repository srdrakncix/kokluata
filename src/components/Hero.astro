---
import { SITE, whatsapp } from '../data/site';
---

<section class="hero" data-hero aria-label="Giriş">
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__glow"></div>
    <div class="hero__grid"></div>
  </div>

  <div class="hero__stage" data-hero-stage aria-hidden="true">
    <canvas class="hero__canvas" data-hero-canvas></canvas>
    <img class="hero__fallback" data-hero-fallback src="/img/gloves-hero.webp" alt="" width="682" height="665" fetchpriority="high" />
  </div>

  <div class="container hero__in">
    <h1 class="hero__title" data-hero-title>
      <span class="hero__word"><span>Köklü</span></span>
      <span class="hero__word"><span>Ata</span></span>
      <span class="hero__word hero__word--outline"><span>Kickboks</span></span>
    </h1>

    <div class="hero__side" data-hero-side>
      <p class="hero__lead">
        Bornova'nın ringi. <strong>{SITE.founded}</strong>'den beri lisanslı sporcu yetiştiren,
        250 m² salonda genç ve yetişkin kickboks dersleri.
      </p>
      <div class="hero__btns">
        <a href={whatsapp()} class="btn btn--wa" target="_blank" rel="noopener">
          Deneme dersine gel
        </a>
        <a href="#dersler" class="btn btn--ghost">Dersleri gör</a>
      </div>
      <a href={SITE.maps} class="hero__rating" target="_blank" rel="noopener">
        <span class="hero__stars" aria-hidden="true">★★★★★</span>
        <span><strong>{SITE.rating.value}</strong> · Google'da {SITE.rating.count}+ yorum</span>
      </a>
    </div>
  </div>

  <div class="hero__scroll" data-hero-scroll aria-hidden="true">
    <span>Kaydır</span>
    <i></i>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    padding-block: 140px 56px;
    overflow: clip;
    isolation: isolate;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 55% 60% at 68% 45%, rgba(216, 16, 46, 0.32), transparent 65%),
      radial-gradient(ellipse 40% 30% at 20% 90%, rgba(216, 16, 46, 0.12), transparent 60%);
  }
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, #000 20%, transparent 75%);
    opacity: 0.6;
  }

  .hero__stage {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .hero__canvas.is-ready {
    opacity: 1;
  }
  .hero__fallback {
    position: absolute;
    right: -6%;
    top: 50%;
    width: min(80vw, 640px);
    height: auto;
    transform: translateY(-52%);
    filter: drop-shadow(0 40px 60px rgba(0, 0, 0, 0.6));
    animation: float 6s ease-in-out infinite;
    display: none;
  }
  .hero.is-fallback .hero__fallback {
    display: block;
  }
  .hero.is-fallback .hero__canvas {
    display: none;
  }
  @keyframes float {
    0%, 100% { transform: translateY(-52%) rotate(-2deg); }
    50% { transform: translateY(-46%) rotate(2deg); }
  }

  .hero__in {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    align-items: end;
    gap: 48px;
  }
  .hero__title {
    font-size: clamp(4.2rem, 12.5vw, 12rem);
    line-height: 0.86;
    letter-spacing: -0.005em;
  }
  .hero__word {
    display: block;
    overflow: hidden;
    padding: 0.14em 0.05em 0.04em 0;
    margin-top: -0.14em;
  }
  .hero__word > span {
    display: block;
    transform: translateY(110%);
    transition: transform 1.1s var(--ease-out);
  }
  .hero.is-in .hero__word > span {
    transform: none;
  }
  .hero.is-in .hero__word:nth-child(2) > span { transition-delay: 0.1s; }
  .hero.is-in .hero__word:nth-child(3) > span { transition-delay: 0.2s; }
  .hero__word--outline {
    color: transparent;
    -webkit-text-stroke: 2px var(--fg);
  }

  .hero__side {
    display: grid;
    gap: 24px;
    padding-bottom: 0.6rem;
  }
  .hero__side > * {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 1s var(--ease-out) 0.5s, transform 1s var(--ease-out) 0.5s;
  }
  .hero.is-in .hero__side > * {
    opacity: 1;
    transform: none;
  }
  .hero.is-in .hero__side > :nth-child(2) { transition-delay: 0.62s; }
  .hero.is-in .hero__side > :nth-child(3) { transition-delay: 0.74s; }
  .hero__lead {
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    color: var(--fg-2);
    max-width: 42ch;
  }
  .hero__lead strong {
    color: var(--fg);
  }
  .hero__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero__rating {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--fg-2);
    font-size: 0.9rem;
  }
  .hero__rating strong {
    color: var(--fg);
  }
  .hero__stars {
    color: #f5b301;
    letter-spacing: 2px;
    font-size: 0.85rem;
  }

  .hero__scroll {
    position: absolute;
    left: var(--gutter);
    bottom: 24px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg-3);
  }
  .hero__scroll i {
    width: 48px;
    height: 1px;
    background: var(--fg-3);
    position: relative;
    overflow: hidden;
  }
  .hero__scroll i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--red-2);
    transform: translateX(-100%);
    animation: scrollLine 2s var(--ease-out) infinite;
  }
  @keyframes scrollLine {
    to { transform: translateX(100%); }
  }

  @media (max-width: 900px) {
    .hero {
      min-height: 0;
      display: flex;
      flex-direction: column;
      padding: 92px 0 40px;
      gap: 8px;
    }
    .hero__stage {
      position: relative;
      inset: auto;
      z-index: 0;
      height: 62vw;
      max-height: 300px;
      display: grid;
      place-items: center;
    }
    .hero__fallback {
      position: static;
      width: min(74vw, 340px);
      transform: none;
      animation: floatM 5s ease-in-out infinite;
    }
    @keyframes floatM {
      0%, 100% { transform: translateY(0) rotate(-2deg); }
      50% { transform: translateY(-10px) rotate(2deg); }
    }
    .hero__in {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .hero__title {
      font-size: clamp(3.4rem, 17.5vw, 7rem);
    }
    .hero__side {
      gap: 18px;
    }
    .hero__btns .btn {
      flex: 1 1 auto;
      justify-content: center;
    }
    .hero__scroll {
      display: none;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger } from '../scripts/core';

  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const canvas = hero.querySelector<HTMLCanvasElement>('[data-hero-canvas]')!;
  const title = hero.querySelector<HTMLElement>('[data-hero-title]')!;
  const side = hero.querySelector<HTMLElement>('[data-hero-side]')!;

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const small = matchMedia('(max-width: 900px)').matches;
  const canGL = (() => {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  })();

  requestAnimationFrame(() => hero.classList.add('is-in'));

  /* text parallax + fade on scroll (all devices) */
  if (!reduced) {
    gsap.to(title, {
      yPercent: -18,
      opacity: 0.15,
      ease: 'none',
      scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true },
    });
    gsap.to(side, {
      yPercent: -30,
      opacity: 0,
      ease: 'none',
      scrollTrigger: { trigger: hero, start: 'top top', end: '60% top', scrub: true },
    });
  }

  if (small || !canGL || reduced) {
    hero.classList.add('is-fallback');
  } else {
    import('../scripts/hero-gloves').then(({ mountGloves }) => mountGloves(canvas, hero)).catch(() => hero.classList.add('is-fallback'));
  }
</script>
