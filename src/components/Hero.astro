---
import { SITE, whatsapp } from '../data/site';
---

<section class="hero" data-hero aria-label="Giriş">
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__glow"></div>
    <div class="hero__grid"></div>
  </div>

  <!-- Katman 1: arkadaki dev başlık -->
  <h1 class="hero__title" data-hero-back aria-label="Köklü Ata Kickboks">
    <span class="hero__word"><span>Köklü <em>Ata</em></span></span>
  </h1>

  <!-- Katman 1.5: ışığın figürün arkasından geçen kısmı -->
  <canvas class="hero__ribbon hero__ribbon--back" data-hero-ribbon-back aria-hidden="true"></canvas>

  <!-- Katman 2: antrenör -->
  <div class="hero__figure" data-hero-figure aria-hidden="true">
    <picture>
      <source media="(max-width: 900px)" srcset="/img/taner-hero-m.webp" />
      <img src="/img/taner-hero.webp" alt="" width="1209" height="1600" fetchpriority="high" decoding="async" />
    </picture>
  </div>

  <!-- Katman 3: ışık şeridi -->
  <canvas class="hero__ribbon" data-hero-ribbon aria-hidden="true"></canvas>

  <!-- Katman 4: öndeki kontur + metin -->
  <div class="hero__front" data-hero-front>
    <p class="hero__kick" aria-hidden="true"><span>Kickboks</span></p>
    <div class="container hero__bar">
      <div class="hero__side" data-hero-side>
        <p class="hero__lead">
          Bornova'nın ringi. <strong>{SITE.founded}</strong>'den beri lisanslı sporcu yetiştiren,
          250 m² salonda genç ve yetişkin kickboks dersleri.
        </p>
        <div class="hero__btns">
          <a href={whatsapp()} class="btn btn--wa" target="_blank" rel="noopener">Deneme dersine gel</a>
          <a href="#dersler" class="btn btn--ghost">Dersleri gör</a>
        </div>
      </div>
      <a href={SITE.maps} class="hero__rating" target="_blank" rel="noopener">
        <span class="hero__stars" aria-hidden="true">★★★★★</span>
        <span><strong>{SITE.rating.value}</strong> · Google'da {SITE.rating.count}+ yorum</span>
      </a>
    </div>
  </div>

  <div class="hero__scroll" aria-hidden="true">
    <span>Kaydır</span>
    <i></i>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 640px;
    overflow: clip;
    isolation: isolate;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 45% 55% at 50% 60%, rgba(216, 16, 46, 0.28), transparent 65%),
      radial-gradient(ellipse 40% 30% at 12% 95%, rgba(216, 16, 46, 0.1), transparent 60%);
  }
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, #000 20%, transparent 75%);
    opacity: 0.55;
  }

  /* --- katman 1: arka başlık --- */
  .hero__title {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 38%;
    transform: translate(-50%, -50%);
    width: max-content;
    max-width: 100vw;
    text-align: center;
    font-size: clamp(5rem, 15.5vw, 16rem);
    line-height: 0.8;
    letter-spacing: -0.005em;
    color: var(--fg);
    pointer-events: none;
    will-change: transform;
  }
  .hero__title em {
    font-style: normal;
    color: var(--red-2);
  }
  .hero__word {
    display: block;
    overflow: hidden;
    padding: 0.14em 0.05em 0.04em;
    margin-top: -0.14em;
  }
  .hero__word > span {
    display: block;
    transform: translateY(110%);
    transition: transform 1.1s var(--ease-out);
  }
  .hero.is-in .hero__word > span {
    transform: none;
  }

  /* --- katman 2: figür --- */
  .hero__figure {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: 0;
    height: 80%;
    transform: translateX(-50%);
    display: flex;
    align-items: flex-end;
    pointer-events: none;
    will-change: transform;
  }
  .hero__figure picture {
    display: block;
    height: 100%;
  }
  .hero__figure img {
    height: 100%;
    width: auto;
    max-width: none;
    filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.55)) contrast(1.02);
    opacity: 0;
    transform: translateY(6%) scale(0.98);
    transition: opacity 1.2s var(--ease-out) 0.15s, transform 1.4s var(--ease-out) 0.15s;
  }
  .hero.is-in .hero__figure img {
    opacity: 1;
    transform: none;
  }

  /* --- katman 3: ışık --- */
  .hero__ribbon {
    position: absolute;
    inset: 0;
    z-index: 3;
  }
  .hero__ribbon--back {
    z-index: 1;
  }
  .hero__ribbon {
    width: 100%;
    height: 100%;
    pointer-events: none;
    mix-blend-mode: screen;
  }

  /* --- katman 4: ön --- */
  .hero__front {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
  }
  .hero__front a,
  .hero__front .btn {
    pointer-events: auto;
  }
  .hero__kick {
    position: absolute;
    left: 50%;
    bottom: 15%;
    transform: translateX(-50%);
    font-family: var(--font-display);
    font-size: clamp(4rem, 15.5vw, 16rem);
    line-height: 0.85;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: transparent;
    -webkit-text-stroke: 2px var(--fg);
    white-space: nowrap;
    overflow: hidden;
    padding: 0.14em 0.05em 0.04em;
    will-change: transform;
  }
  .hero__kick > span {
    display: block;
    transform: translateY(110%);
    transition: transform 1.1s var(--ease-out) 0.25s;
  }
  .hero.is-in .hero__kick > span {
    transform: none;
  }
  .hero__bar {
    position: absolute;
    left: 50%;
    bottom: 40px;
    transform: translateX(-50%);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
  }
  .hero__side {
    display: grid;
    gap: 20px;
    max-width: 380px;
  }
  .hero__side > *,
  .hero__rating {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 1s var(--ease-out) 0.55s, transform 1s var(--ease-out) 0.55s;
  }
  .hero.is-in .hero__side > *,
  .hero.is-in .hero__rating {
    opacity: 1;
    transform: none;
  }
  .hero.is-in .hero__side > :nth-child(2) {
    transition-delay: 0.65s;
  }
  .hero__lead {
    font-size: clamp(0.95rem, 1.15vw, 1.05rem);
    color: var(--fg-2);
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.6);
  }
  .hero__lead strong {
    color: var(--fg);
  }
  .hero__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero__rating {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--fg-2);
    font-size: 0.9rem;
    padding-bottom: 6px;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.6);
  }
  .hero__rating strong {
    color: var(--fg);
  }
  .hero__stars {
    color: #f5b301;
    letter-spacing: 2px;
    font-size: 0.85rem;
  }

  .hero__scroll {
    position: absolute;
    z-index: 5;
    left: var(--gutter);
    top: 50%;
    transform: rotate(-90deg) translateX(-50%);
    transform-origin: left top;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg-3);
  }
  .hero__scroll i {
    width: 48px;
    height: 1px;
    background: var(--fg-3);
    position: relative;
    overflow: hidden;
  }
  .hero__scroll i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--red-2);
    transform: translateX(-100%);
    animation: scrollLine 2s var(--ease-out) infinite;
  }
  @keyframes scrollLine {
    to {
      transform: translateX(100%);
    }
  }

  @media (max-width: 900px) {
    .hero {
      min-height: 600px;
    }
    .hero__title {
      top: 19%;
      transform: translate(-50%, -50%);
      font-size: clamp(4.2rem, 21vw, 8rem);
      line-height: 0.82;
    }
    .hero__title .hero__word > span {
      display: grid;
    }
    .hero__figure {
      height: 46%;
      bottom: 31%;
    }
    .hero__kick {
      bottom: 32%;
      font-size: clamp(3rem, 18vw, 5.5rem);
    }
    .hero__bar {
      flex-direction: column;
      align-items: stretch;
      bottom: 16px;
      gap: 12px;
    }
    .hero__rating {
      padding-bottom: 0;
      font-size: 0.8rem;
    }
    .hero__side {
      max-width: none;
      gap: 14px;
    }
    .hero__lead {
      font-size: 0.95rem;
    }
    .hero__btns .btn {
      flex: 1 1 auto;
      justify-content: center;
    }
    .hero__scroll {
      display: none;
    }
  }
</style>

<script>
  import { gsap } from '../scripts/core';

  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const back = hero.querySelector<HTMLElement>('[data-hero-back]')!;
  const figure = hero.querySelector<HTMLElement>('[data-hero-figure]')!;
  const front = hero.querySelector<HTMLElement>('[data-hero-front]')!;
  const canvas = hero.querySelector<HTMLCanvasElement>('[data-hero-ribbon]')!;
  const canvasBack = hero.querySelector<HTMLCanvasElement>('[data-hero-ribbon-back]')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  requestAnimationFrame(() => hero.classList.add('is-in'));

  /* derinlik: arka başlık hızlı, figür yavaş, ön kontur orta */
  if (!reduced) {
    const st = { trigger: hero, start: 'top top', end: 'bottom top', scrub: true };
    gsap.to(back, { yPercent: -35, opacity: 0.2, ease: 'none', scrollTrigger: st });
    gsap.to(figure, { yPercent: 12, ease: 'none', scrollTrigger: st });
    gsap.to(front, { yPercent: -18, opacity: 0, ease: 'none', scrollTrigger: st });
    import('../scripts/hero-ribbon').then(({ mountRibbon }) => mountRibbon(canvas, canvasBack, hero, figure));
  }
</script>
