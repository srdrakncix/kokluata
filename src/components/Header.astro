---
import { NAV, SITE, whatsapp } from '../data/site';
const path = Astro.url.pathname;
---

<header class="hdr" data-header>
  <div class="container hdr__in">
    <a href="/" class="hdr__logo" aria-label={SITE.name + ' ana sayfa'}>
      <img src="/img/logo-mark.svg" alt="" width="40" height="40" />
      <span class="hdr__word">Köklü Ata<br /><em>Kickboks</em></span>
    </a>

    <nav class="hdr__nav" aria-label="Ana menü">
      {NAV.map((n) => (
        <a href={n.href} class:list={['hdr__link', { 'is-active': path.startsWith(n.href) }]}>
          {n.label}
        </a>
      ))}
    </nav>

    <a href={whatsapp()} class="btn btn--wa hdr__cta" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.6.3-.5c.1-.2 0-.4 0-.5L9.2 6.7c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.2-.7-.4zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2z"/></svg>
      Deneme Dersi
    </a>

    <button class="hdr__burger" data-burger aria-label="Menüyü aç" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span>
    </button>
  </div>

  <div class="mnav" id="mobile-menu" data-mnav hidden>
    <nav aria-label="Mobil menü">
      {NAV.map((n, i) => (
        <a href={n.href} class="mnav__link" style={`--i:${i}`}>{n.label}</a>
      ))}
    </nav>
    <div class="mnav__foot">
      <a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a>
      <a href={whatsapp()} class="btn btn--wa" target="_blank" rel="noopener">WhatsApp'tan yaz</a>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    padding-block: 18px;
    transition: background 0.4s, padding 0.4s, box-shadow 0.4s;
  }
  .hdr.is-scrolled {
    padding-block: 10px;
    background: rgba(10, 10, 11, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 var(--line);
  }
  .hdr__in {
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .hdr__logo {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-right: auto;
  }
  .hdr__word {
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 0.95;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .hdr__word em {
    font-style: normal;
    color: var(--red-2);
  }
  .hdr__nav {
    display: flex;
    gap: 6px;
  }
  .hdr__link {
    position: relative;
    padding: 10px 14px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--fg-2);
    transition: color 0.3s;
  }
  .hdr__link::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 6px;
    height: 2px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease-out);
  }
  .hdr__link:hover,
  .hdr__link.is-active {
    color: var(--fg);
  }
  .hdr__link:hover::after,
  .hdr__link.is-active::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .hdr__cta {
    padding: 12px 20px;
    font-size: 0.85rem;
  }
  .hdr__burger {
    display: none;
    width: 44px;
    height: 44px;
    position: relative;
  }
  .hdr__burger span {
    position: absolute;
    left: 10px;
    right: 10px;
    height: 2px;
    background: var(--fg);
    transition: transform 0.4s var(--ease-out), top 0.4s var(--ease-out);
  }
  .hdr__burger span:nth-child(1) { top: 17px; }
  .hdr__burger span:nth-child(2) { top: 25px; }
  .hdr__burger[aria-expanded='true'] span:nth-child(1) { top: 21px; transform: rotate(45deg); }
  .hdr__burger[aria-expanded='true'] span:nth-child(2) { top: 21px; transform: rotate(-45deg); }

  .mnav {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: var(--bg);
    padding: 110px var(--gutter) 40px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s;
  }
  .mnav.is-open {
    opacity: 1;
    pointer-events: auto;
  }
  .mnav nav {
    display: flex;
    flex-direction: column;
  }
  .mnav__link {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 11vw, 4.5rem);
    line-height: 1.05;
    text-transform: uppercase;
    padding-block: 4px;
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s var(--ease-out), transform 0.5s var(--ease-out);
    transition-delay: calc(var(--i) * 60ms + 80ms);
  }
  .mnav.is-open .mnav__link {
    opacity: 1;
    transform: none;
  }
  .mnav__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: var(--fg-2);
  }

  @media (max-width: 960px) {
    .hdr__nav,
    .hdr__cta {
      display: none;
    }
    .hdr__burger {
      display: block;
    }
    .hdr.is-open {
      background: var(--bg);
    }
  }
</style>

<script>
  const hdr = document.querySelector<HTMLElement>('[data-header]')!;
  const burger = hdr.querySelector<HTMLButtonElement>('[data-burger]')!;
  const mnav = hdr.querySelector<HTMLElement>('[data-mnav]')!;

  const onScroll = () => hdr.classList.toggle('is-scrolled', window.scrollY > 24);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });

  burger.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') !== 'true';
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Menüyü kapat' : 'Menüyü aç');
    mnav.hidden = false;
    requestAnimationFrame(() => mnav.classList.toggle('is-open', open));
    hdr.classList.toggle('is-open', open);
    document.documentElement.classList.toggle('lenis-stopped', open);
    if (!open) setTimeout(() => (mnav.hidden = true), 350);
  });
</script>
